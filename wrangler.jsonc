{
  // Web de Academia Detail en Cloudflare (Workers con assets estáticos).
  // Dominio de producción asignado en el corte del 27-09-2026 (custom domain).
  // Marcha atrás: quitar la ruta y recrear en Cloudflare DNS el registro de
  // academiadetail.com que apuntaba a Lovable (ver ESTADO/memoria del corte).
  // www.academiadetail.com no se sirve aquí: lo redirige a la raíz una regla de Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academia-detail",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "academiadetail.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
