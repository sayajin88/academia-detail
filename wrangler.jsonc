{
  // Web de Academia Detail en Cloudflare (Workers con assets estáticos).
  // Dominio de producción asignado en el corte del 27-09-2026 (custom domain).
  // Marcha atrás: quitar la ruta y recrear en Cloudflare DNS el registro de
  // academiadetail.com que apuntaba a Lovable (ver ESTADO/memoria del corte).
  // www.academiadetail.com no se sirve aquí: lo redirige a la raíz una regla de Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academia-detail",
  "compatibility_date": "2026-09-18",
  // El Worker solo atiende las URL que no son un archivo del build: redirecciones
  // 301 de URL antiguas, 404 reales y la SPA para rutas no pre-renderizadas.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  // Valores públicos (los mismos que lleva el frontend) para comprobar si existe un
  // artículo o un detailer antes de responder 404.
  "vars": {
    "SUPABASE_URL": "https://kvsrmbutyqyaaaukvgll.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt2c3JtYnV0eXF5YWFhdWt2Z2xsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA1MTEzNzYsImV4cCI6MjEwNjA4NzM3Nn0.xcjvTQSWt-KTaYeerrfIzXiCiA8w8dTeRAFufIPj28I"
  },
  "routes": [{ "pattern": "academiadetail.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
